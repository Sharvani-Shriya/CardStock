# Port the HTTP + WebSocket server listens on
PORT=4000

# Any MongoDB connection string (local mongod or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/kanban

# Origin(s) allowed by CORS. Must match the URL where the Vite client runs.
# Use a comma-separated list to allow more than one.
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign access tokens (JWTs).  Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Secret used to sign refresh tokens.  Must be at least 32 characters and
# different from JWT_ACCESS_SECRET.
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-at-least-32ch

# Set to "true" when the server is behind HTTPS (always true in production).
# When true the refresh cookie gets the Secure flag so it is only sent over TLS.
COOKIE_SECURE=false

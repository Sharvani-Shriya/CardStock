# Port the HTTP + WebSocket server listens on (Render sets PORT automatically)
PORT=4000

# Node execution environment: development | production | test
NODE_ENV=development

# MongoDB connection string (local mongod or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/kanban

# Allowed CORS origins (comma-separated list for multiple origins)
# In development: http://localhost:5173
# In production: https://<your-vercel-app>.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign short-lived (15 min) JWT access tokens.
# Must be at least 32 characters long.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars-using-openssl

# Secret used to generate refresh tokens.
# Must be at least 32 characters long and different from JWT_ACCESS_SECRET.
# Generate with: openssl rand -base64 48
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-at-least-32ch-using-openssl

# Set to "true" when serving over HTTPS/TLS (always true in production on Render).
# When true, the HttpOnly refresh cookie is issued with the Secure flag.
COOKIE_SECURE=false

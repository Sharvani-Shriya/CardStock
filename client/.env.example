# Base URL of the REST API (no trailing slash, no /api suffix).
# In local development: http://localhost:4000
# When deployed on Vercel with rewrites: empty string or left unset (calls same-origin /api)
# When calling backend directly: https://<your-render-service>.onrender.com
VITE_API_URL=http://localhost:4000

# Full URL of the WebSocket endpoint, including the /ws path.
# In local development: ws://localhost:4000/ws
# In production on Render: wss://<your-render-service>.onrender.com/ws
VITE_WS_URL=ws://localhost:4000/ws
